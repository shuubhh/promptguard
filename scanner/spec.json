{
  "version": "1.0",
  "description": "PromptGuard scanner spec — single source of truth for pattern data. Read by both scanner/promptguard_scanner.py (Python) and dashboard/src/lib/repoScanner.js (JS). Keep the two implementations in sync by editing THIS file.",
  "secret_patterns": [
    { "key": "aws_access_key", "label": "AWS Access Key", "severity": "critical", "pattern": "\\bAKIA[0-9A-Z]{16}\\b" },
    { "key": "aws_secret_key", "label": "AWS Secret Key", "severity": "critical", "pattern": "(?i)aws.{0,20}secret.{0,20}['\"][0-9a-zA-Z/+]{40}['\"]" },
    { "key": "github_token", "label": "GitHub Personal Access Token", "severity": "critical", "pattern": "\\bghp_[a-zA-Z0-9]{36}\\b" },
    { "key": "github_oauth", "label": "GitHub OAuth Token", "severity": "critical", "pattern": "\\bgho_[a-zA-Z0-9]{36}\\b" },
    { "key": "gitlab_token", "label": "GitLab Personal Access Token", "severity": "critical", "pattern": "\\bglpat-[a-zA-Z0-9\\-]{20}\\b" },
    { "key": "stripe_secret_key", "label": "Stripe Secret Key", "severity": "critical", "pattern": "\\bsk_live_[a-zA-Z0-9]{24,}\\b" },
    { "key": "stripe_publishable", "label": "Stripe Publishable Key", "severity": "high", "pattern": "\\bpk_live_[a-zA-Z0-9]{24,}\\b" },
    { "key": "twilio_sid", "label": "Twilio Account SID", "severity": "high", "pattern": "\\bAC[a-f0-9]{32}\\b" },
    { "key": "sendgrid_key", "label": "SendGrid API Key", "severity": "critical", "pattern": "\\bSG\\.[a-zA-Z0-9\\-_]{22}\\.[a-zA-Z0-9\\-_]{43}\\b" },
    { "key": "brevo_smtp_key", "label": "Brevo SMTP Key", "severity": "critical", "pattern": "\\bxsmtpsib-[a-f0-9]{64}-[a-zA-Z0-9]{16}\\b" },
    { "key": "db_connection_string", "label": "Database Connection String", "severity": "critical", "pattern": "(?:mongodb|postgresql|postgres|mysql|redis|mssql|sqlserver)://[^\\s\"']{10,}" },
    { "key": "private_key", "label": "Private Key (PEM/PGP/SSH)", "severity": "critical", "pattern": "-----BEGIN (?:RSA |EC |PGP |OPENSSH )?PRIVATE KEY(?: BLOCK)?-----" },
    { "key": "jwt_token", "label": "JWT Token", "severity": "high", "pattern": "eyJ[A-Za-z0-9\\-_=]+\\.[A-Za-z0-9\\-_=]+\\." },
    { "key": "aadhaar_number", "label": "Aadhaar Number", "severity": "high", "pattern": "\\b[2-9]{1}[0-9]{3}\\s?[0-9]{4}\\s?[0-9]{4}\\b", "validator": "verhoeff" },
    { "key": "pan_number", "label": "PAN Number", "severity": "medium", "pattern": "\\b[A-Z]{5}[0-9]{4}[A-Z]{1}\\b" },
    { "key": "generic_password", "label": "Hardcoded Password", "severity": "high", "pattern": "(?i)(?:password|passwd|pwd|secret|api_key|apikey|auth_token)\\s*[=:]\\s*['\"][^'\"]{8,}['\"]", "validator": "entropy" },
    { "key": "anthropic_api_key", "label": "Anthropic API Key", "severity": "critical", "pattern": "\\bsk-ant-[a-zA-Z0-9_-]{20,}\\b" },
    { "key": "openai_api_key", "label": "OpenAI API Key", "severity": "critical", "pattern": "\\bsk-(?:proj|svcacct)-[a-zA-Z0-9_-]{20,}\\b" },
    { "key": "slack_token", "label": "Slack Token", "severity": "high", "pattern": "\\bxox[baprs]-[a-zA-Z0-9-]{10,}\\b" },
    { "key": "google_api_key", "label": "Google API Key", "severity": "high", "pattern": "\\bAIza[0-9A-Za-z_-]{35}\\b" },
    { "key": "indian_phone", "label": "Indian Phone Number", "severity": "low", "pattern": "(?<!\\d)(?:\\+91|0)?[6-9]\\d{9}(?!\\d)" }
  ],
